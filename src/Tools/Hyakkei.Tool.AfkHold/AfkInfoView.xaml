<UserControl x:Class="Hyakkei.Tool.AfkHold.AfkInfoView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="28,24" MaxWidth="640" HorizontalAlignment="Left">
            <TextBlock Text="挂机" FontSize="26" FontWeight="SemiBold"
                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
            <TextBlock Text="组合长按：一键同时按住若干键盘键与鼠标键。操作在岛内完成。"
                       FontSize="13" Margin="0,4,0,20"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />

            <Border Background="{DynamicResource ControlFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="16,14">
                <TextBlock FontSize="13" TextWrapping="Wrap" LineHeight="24"
                           Foreground="{DynamicResource TextFillColorPrimaryBrush}">
                    <Run Text="进入岛面板挂载热键" /><Run x:Name="HotkeyRun" FontWeight="SemiBold" /><Run Text="：按一次同时按住整套组合（默认 ~ + W + 左键），再按一次全部松开" />
                    <LineBreak />
                    <Run Text="配组合：点键位芯片移除，点 + 捕获新键（最多 4 个）；鼠标分段选 左键 / 右键 / 无" />
                    <LineBreak />
                    <Run Text="岛隐藏后热键依然有效；Esc 或单击 Alt 返回列表即松开全部按键并解除热键" />
                </TextBlock>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
